# ArtSync — Shopify Inventory Bridge
# Copy to .env for local development.

# mock = local demo with simulated Shopify inventory (default)
# live = real Shopify Admin GraphQL mutations (use with: npm run dev:live)
ARTSYNC_MODE=mock

# Used when ARTSync_MODE=mock
ARTSYNC_DEMO_SHOP=artsync-demo.myshopify.com

# Supplier API hardening
ARTSYNC_PAYLOAD_MAX_BYTES=16384
ARTSYNC_TIMESTAMP_TOLERANCE_MS=300000
ARTSYNC_RATE_LIMIT_MAX=60

# --- Required for ARTSync_MODE=live / shopify app dev ---
# Provided by Shopify CLI after `shopify app config link` / `shopify app dev`
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations
SHOPIFY_APP_URL=
# SHOP_CUSTOM_DOMAIN=
